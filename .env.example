# Локално (docker compose up -d)
DATABASE_URL=postgres://prognozi:prognozi@localhost:5433/prognozi

# В продукция (Vercel): адресът на Neon С "-pooler" в хоста, напр.
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/prognozi?sslmode=require
#
# За миграции и скриптове от твоята машина се ползва адресът БЕЗ "-pooler" —
# pooler-ът не поддържа нещата на ниво сесия, които drizzle-kit ползва.
# Виж DEPLOY.md, раздел "Двата connection string-а".

# Таен низ за /api/cron/refresh. Генерирай с: openssl rand -hex 32
CRON_SECRET=

# Източник на графика
SCHEDULE_URL=https://bulgarian-football.com/elitna-grupa-u17.html

# Контакт в User-Agent на скрейпъра (изисква добър тон към източника)
SCRAPER_CONTACT=alexander.iankov@gmail.com

# Публичният адрес на сайта — влиза в линковете от имейлите.
# На Vercel не е задължителен: адресът се взема от VERCEL_PROJECT_PRODUCTION_URL.
APP_URL=http://localhost:3000

# Изпращане на имейл (линкове за нова парола). Работи с всеки SMTP доставчик.
# Ако е празно, в разработка писмото се изписва в конзолата вместо да се изпраща.
#
#   Gmail:    smtp.gmail.com / 587 / твоят имейл / App Password (иска 2FA)
#   Brevo:    smtp-relay.brevo.com / 587 — позволява подател без собствен домейн
#   SendGrid: smtp.sendgrid.net / 587 / потребител "apikey"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Прогнози U-17 <prognozi@example.com>
